# ── Model paths ───────────────────────────────────────────────────────────────
HELMET_MODEL_PATH=models/helmet.pt
PLATE_MODEL_PATH=models/plate.pt
HSRP_MODEL_PATH=models/hsrp.pt
VEHICLE_MODEL_PATH=models/vehicle.pt

# ── Security ───────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Thresholds (paper values) ──────────────────────────────────────────────────
HELMET_CONF_THRESHOLD=0.25
HSRP_CONF_THRESHOLD=0.50
OCR_CONF_THRESHOLD=0.45
VEHICLE_CONF_THRESHOLD=0.40
RIDER_IOU_THRESHOLD=0.40
PLATE_IOU_THRESHOLD=0.40
HEAD_CROP_RATIO=0.35
HELMET_NO_THRESHOLD=0.40
HELMET_YES_THRESHOLD=0.60
FRAME_SKIP=1

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/smart_hsrp

# ── Storage ────────────────────────────────────────────────────────────────────
STORAGE_DIR=static

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── API ────────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
