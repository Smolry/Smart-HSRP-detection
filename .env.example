PROJECT_NAME="Smart HSRP Number Detection System using AI"
VERSION=1.0.2026
FRAME_SKIP=2

# --- Database & Storage ---
# Use sqlite for dev, or postgresql://user:pass@localhost/db for prod
DATABASE_URL=
STORAGE_DIR=static

# Security Configuration
SECRET_KEY=your-secret-key-change-in-production-please-use-strong-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS orifgin list ---
CORS_ORIGINS=http://your-ec2-ip,https://your-domain.com

# --- Backend Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=True

# --- AWS ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Model Threshold Overrides ---
# Higher thresholds = Fewer false fines (Better for Legal Compliance)


#HELMET_CONF_THRESHOLD=0.60
#HSRP_CONF_THRESHOLD=0.6
#OCR_CONF_THRESHOLD=0.65
#VEHICLE_CONF_THRESHOLD=0.4
#RIDER_IOU_THRESHOLD =0.1
#PLATE_IOU_THRESHOLD =0.2
#HEAD_CROP_RATIO =0.45
#HELMET_NO_THRESHOLD=0.75
#HELMET_YES_THRESHOLD=0.65


# Balanced ()
#HELMET_CONF_THRESHOLD=0.6
#HSRP_CONF_THRESHOLD=0.55
#OCR_CONF_THRESHOLD=0.55
#VEHICLE_CONF_THRESHOLD=0.4
#RIDER_IOU_THRESHOLD =0.1
#PLATE_IOU_THRESHOLD =0.2
#HEAD_CROP_RATIO =0.45
#HELMET_NO_THRESHOLD=0.7
#HELMET_YES_THRESHOLD=0.6

# Aggressive (More Detections)
HSRP_CONF_THRESHOLD=0.5
OCR_CONF_THRESHOLD=0.55
VEHICLE_CONF_THRESHOLD=0.4
RIDER_IOU_THRESHOLD =0.1
PLATE_IOU_THRESHOLD =0.2
HEAD_CROP_RATIO =0.30
HELMET_CONF_THRESHOLD = 0.25  #(minimum detection filter)
HELMET_YES_THRESHOLD = 0.60
HELMET_NO_THRESHOLD  = 0.40


# --- Model Weights (Relative to project root) ---
HELMET_MODEL_PATH=weights/helmet.pt
PLATE_MODEL_PATH=weights/plate_detector.pt
HSRP_MODEL_PATH=weights/hsrp_cls.pt
VEHICLE_MODEL_PATH=weights/vehicle-person.pt

